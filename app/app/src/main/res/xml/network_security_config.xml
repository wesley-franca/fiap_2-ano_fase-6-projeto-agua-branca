<?xml version="1.0" encoding="utf-8"?>
<!--
  O backend do projeto roda em HTTP na rede local (emulador em 10.0.2.2 ou IP da máquina).
  Quando a API for publicada em HTTPS, troque para cleartextTrafficPermitted="false".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
