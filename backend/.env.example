# Copie para .env e ajuste se necessário. Todos os valores são opcionais.

# Porta da API exposta na sua máquina
API_PORT=8080

# Conexão da API com o MongoDB (padrão: serviço "mongo" do docker-compose)
MONGODB_URI=mongodb://mongo:27017/inovacao

# Segredo para assinar os tokens JWT (HS256) — mínimo 32 caracteres. Troque fora do ambiente local.
JWT_SECRET=dev-local-inovacao-aguia-branca-troque-este-segredo

# Validade do token (ex.: 30m, 8h, 1d)
JWT_EXPIRATION=8h

# Popula o banco com usuários e dados de demonstração na inicialização
SEED_ENABLED=true
